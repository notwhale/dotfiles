#!/bin/sh
# Toggle the scratchpad tmux session.
#
# The session name and directory come from the environment. Keeping this in a
# script instead of .tmux.conf is necessary because tmux does not expand
# formats or environment variables in target arguments (-t).
#
# The key binding passes the server socket and client explicitly, so a nested
# tmux (where $TMUX may point at an outer server) still toggles the right one.

dir=${SCRATCHPAD_DIR:-$HOME/scratchpad}
case $dir in
	"~/"*) dir=$HOME/${dir#"~/"} ;;
esac
session=${SCRATCHPAD_SESSION:-scratchpad}

mkdir -p "$dir" || exit 1

socket=${1:-}
client=${2:-}
current=${3:-}

# Target the server the binding belongs to instead of whatever $TMUX says.
if [ -n "$socket" ]; then
	tmux() { command tmux -S "$socket" "$@"; }
fi

pane=${TMUX_PANE:-}
if [ -z "$pane" ] && [ -z "$client" ]; then
	# Not inside tmux: just open the scratchpad directory.
	cd "$dir" && exec nvim
fi

if [ -z "$client" ] && [ -n "$pane" ]; then
	client=$(tmux display-message -p -t "$pane" '#{client_name}' 2>/dev/null)
fi
if [ -z "$current" ] && [ -n "$pane" ]; then
	current=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)
fi
[ -n "$client" ] || exit 1

# Already in the scratchpad session: hide it by returning to the last session.
if [ "$current" = "$session" ]; then
	tmux switch-client -c "$client" -l
	exit 0
fi

if tmux has-session -t "=$session" 2>/dev/null; then
	# Make sure the scratchpad window exists in position 1, but do not select
	# it: other windows in the session keep their current focus. -b inserts
	# before window 1; -d keeps it from becoming the current window.
	if ! tmux list-windows -t "=$session" -F '#{window_index}:#{window_name}' 2>/dev/null |
		grep -Fqx "1:$session"; then
		tmux new-window -b -d -t "=$session:1" -n "$session" -c "$dir" "nvim"
	fi
else
	tmux new-session -d -s "$session" -c "$dir" -n "$session" "nvim"
fi

tmux switch-client -c "$client" -t "=$session"
