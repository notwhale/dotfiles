# Homebrew. Absolute path: this file also runs in non-login shells, where brew
# is not on PATH yet. typeset -U makes a repeated shellenv call idempotent.
eval "$(/opt/homebrew/bin/brew shellenv)"
typeset -gU path PATH

# ZSH
typeset -g ZSH_SHARE_DIR=/opt/homebrew/share

# Containers
export DOCKER_DEFAULT_PLATFORM=linux/amd64
